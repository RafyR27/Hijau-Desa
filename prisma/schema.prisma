// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  warga
  petugas
  warung
  admin
}

enum QrTokenStatus {
  available
  pending
  success
}

model Session {
  id                  String   @id
  expiresAt           DateTime
  token               String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  ipAddress           String?
  userAgent           String?
  impersonatedBy      String?

  userId              String
  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([issuer, accountId])
}

model Verification {
  id                  String   @id
  identifier          String
  value               String
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([identifier])
}

model User {
  id                           String   @id
  name                         String
  email                        String   @unique
  emailVerified                Boolean  @default(false)
  image                        String?
  noHP                         String?  @unique
  noRumah                      String?
  role                         Role     @default(warga)
  statusVerifikasi             Boolean  @default(false)
  rejectionReason              String?
  newAccount                   Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  // Better Auth
  sessions                     Session[]
  accounts                     Account[]
  banned                       Boolean?  @default(false)
	banReason                    String?
	banExpires                   DateTime? @db.Timestamptz(3)

  qrTokens                     QrToken[]
  saldoPoinWarga               PoinWarga?
  saldoPoinWarung              PoinWarung?
  transaksiSetorSebagaiWarga   TransaksiSetor[] @relation("WargaSetor")
  transaksiSetorSebagaiPetugas TransaksiSetor[] @relation("PetugasProses")
  transaksiTukarSebagaiWarga   TransaksiTukar[] @relation("WargaTukar")
  transaksiTukarSebagaiWarung  TransaksiTukar[] @relation("WarungTerima")
  notificationReads            NotificationRead[]
  reimbursementsSebagaiWarung  Reimbursement[] @relation("WarungReimbursement")
  reimbursementsDiprosesAdmin  Reimbursement[] @relation("AdminReimbursement")
}

model QrToken {
  id                   Int      @id @default(autoincrement())
  token                String   @unique
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  createdAt            DateTime @default(now())
  expiredAt            DateTime 
  status               QrTokenStatus  @default(available)
}

model PoinWarga {
  id                Int  @id @default(autoincrement())
  userId            String  @unique
  user              User @relation(fields: [userId], references: [id])
  saldo             Int  @default(0)
}

model PoinWarung {
  id                       Int  @id @default(autoincrement())
  userId                   String  @unique
  user                     User @relation(fields: [userId], references: [id])
  saldoPoinTukarWarung     Int  @default(0)
  saldoRupiah              Int @default(0)
}

model KategoriSampah {
  id                        Int    @id @default(autoincrement())
  namaKategori              String // misal: "Plastik & Botol", "Kertas & Kardus", "Logam & Kaleng"
  ratePoinPerKg             Int    // poin per kg untuk kategori ini
  isActive                  Boolean @default(true)

  transaksiSetor            TransaksiSetor[]
}

model TransaksiSetor {
  id                      Int      @id @default(autoincrement())
  wargaId                 String
  warga                   User     @relation("WargaSetor", fields: [wargaId], references: [id])
  petugasId               String
  petugas                 User     @relation("PetugasProses", fields: [petugasId], references: [id])
  kategoriId              Int
  kategori                KategoriSampah @relation(fields: [kategoriId], references: [id])
  beratKg                 Float
  poinMasuk               Int
  createdAt               DateTime @default(now())
}

model Product {
  id                      Int    @id @default(autoincrement())
  image                   String?
  namaProduct             String
  hargaPoin               Int    
  isActive                Boolean @default(true)

  transaksiTukar          TransaksiTukar[]
}

model TransaksiTukar {
  id                      Int      @id @default(autoincrement())
  wargaId                 String
  warga                   User     @relation("WargaTukar", fields: [wargaId], references: [id])
  warungId                String
  warung                  User     @relation("WarungTerima", fields: [warungId], references: [id])
  productId               Int
  product                 Product  @relation(fields: [productId], references: [id])
  poinKeluar              Int
  createdAt               DateTime @default(now())
}

model Notification {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  reads       NotificationRead[]
}

model NotificationRead {
  id             Int      @id @default(autoincrement())
  notificationId Int
  userId         String
  isRead         Boolean
  readAt         DateTime @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model Konfigurasi {
  id                         Int   @id @default(autoincrement())
  ratePoinKeRupiah           Int   @default(100)
}

model Reimbursement {
  id              Int      @id @default(autoincrement())

  warungId        String
  warung          User     @relation("WarungReimbursement", fields: [warungId], references: [id])

  jumlahPoin      Int
  jumlahRupiah    Int

  status          Boolean  @default(false)

  diprosesOlehId  String?
  diprosesOleh    User?    @relation("AdminReimbursement", fields: [diprosesOlehId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([warungId])
  @@index([status])
}